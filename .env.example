POSTGRES_USER=gefion
POSTGRES_PASSWORD=gefionpass
POSTGRES_DB=gefion
POSTGRES_PORT=5432
POSTGRES_DATA_DIR=./db

# ALPHAVANTAGE_API_KEY=your_key_here
# DATABASE_URL for local development (outside docker)
# Template: postgresql://{USER}:{PASSWORD}@localhost:{POSTGRES_PORT}/{DB}
# Must manually match POSTGRES_PORT value above (no variable expansion in .env files)
# DATABASE_URL=postgresql://gefion:gefionpass@localhost:5432/gefion

# Host capability posture (MCP system_status, #158)
# GEFION_ENV declares host identity; capability (disk/mem/cpu) is auto-measured.
# Unset -> dev (fail-conservative): a dev host bounds data ops regardless of
# measured headroom. Set GEFION_ENV=production on unconstrained hosts (e.g. prod).
# GEFION_ENV=dev
# GEFION_MIN_FREE_DISK_GB=20
# GEFION_MIN_FREE_MEM_GB=2

# Observability (Grafana Tempo)
# Unset -> auto-enabled for interactive terminal sessions (real dev runs);
# tests, CI, and non-interactive/piped runs (e.g. worktree agents) stay off
# (#185). Set OTEL_ENABLED=false to force off even in an interactive shell,
# or leave it explicit as below to force on for non-interactive runs too.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=gefion
OTEL_EXPORTER=otlp
OTEL_OTLP_ENDPOINT=http://localhost:4317
OTEL_SAMPLING_RATE=1.0

# Tempo / Grafana ports (used by docker/tempo/docker-compose.tempo.yml)
TEMPO_HTTP_PORT=3200
TEMPO_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318
GRAFANA_PORT=3000
